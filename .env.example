# Database
DATABASE_URL=sqlite:indexflow.db?mode=rwc
DB_MAX_CONNECTIONS=5

# HTTP server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Scheduler (seconds)
SCHEDULER_INTERVAL_SECS=60
SCHEDULER_BATCH_SIZE=200

# Workers
WORKER_POLL_INTERVAL_SECS=2
SUBMIT_WORKER_INTERVAL_SECS=5
SYNC_WORKER_BATCH=2
CHECK_WORKER_BATCH=10
SUBMIT_WORKER_BATCH=1
MAX_TASK_RETRIES=5
GOOGLE_DAILY_QUOTA=200

# Admin JWT (use a strong secret in production)
JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=168

# Logging
RUST_LOG=indexflow_core=debug,tower_http=info

DRY_RUN=false
